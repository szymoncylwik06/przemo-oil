---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { contact, trustPoints, brands } from "../data/site";
import heroImg from "../assets/images/hero-oil-pour.jpg";

const tickerBrands = [...brands, ...brands];
---

<section id="top" class="hero noise" aria-label="Przemo-Oil - oleje, płyny i smary w Siedlcach">
  <div class="hero__media">
    <Image
      src={heroImg}
      alt="Wymiana oleju silnikowego - lanie świeżego oleju do silnika"
      class="hero__img"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__stripe" aria-hidden="true"></div>
  <span class="hero__drip" aria-hidden="true"></span>

  <div class="shell hero__inner">
    <p class="kicker kicker--light hero-anim" style="animation-delay:.1s">
      Siedlce · ul. Zambrowska 42
    </p>

    <h1 class="hero__title hero-anim" style="animation-delay:.2s">
      Przemo<span class="hero__title-accent">-Oil</span>
    </h1>

    <p class="hero__lead hero-anim" style="animation-delay:.32s">
      <strong>Oleje · płyny · smary</strong> do Twojego auta i maszyn.
      Sprawdzone marki, fachowe doradztwo - <span class="hero__hl">hurt i detal</span> w sercu Siedlec.
    </p>

    <div class="hero__cta hero-anim" style="animation-delay:.44s">
      <a href={contact.phoneHref} class="btn" data-call="hero">
        <Icon name="phone" size={20} />
        Zadzwoń: {contact.phoneDisplay}
      </a>
      <a href="#asortyment" class="btn btn--ghost">
        Zobacz asortyment
        <Icon name="arrow-down" size={18} />
      </a>
    </div>

    <ul class="hero__trust hero-anim" style="animation-delay:.56s">
      {trustPoints.map((t) => (
        <li><Icon name="check" size={16} /> {t}</li>
      ))}
    </ul>
  </div>

  <a href="#o-nas" class="hero__scroll hero-anim" style="animation-delay:.8s" aria-label="Przewiń w dół">
    <span>Przewiń</span>
    <Icon name="chevron-down" size={20} />
  </a>

  <!-- Pasek marek (teaser zaufania) -->
  <div class="hero__ticker" aria-hidden="true">
    <div class="hero__ticker-track">
      {tickerBrands.map((b) => <span class="hero__ticker-item">{b}</span>)}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: var(--color-navy-950);
    padding-top: 72px;
  }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    animation: kenburns 18s ease-out forwards alternate;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, var(--color-navy-950) 18%, rgba(6, 13, 32, 0.86) 45%, rgba(6, 13, 32, 0.35) 78%),
      radial-gradient(60% 70% at 12% 80%, rgba(13, 27, 62, 0.7), transparent 60%);
  }

  .hero__stripe {
    position: absolute;
    top: 0;
    left: 0;
    width: 8px;
    height: 100%;
    background: repeating-linear-gradient(
      180deg,
      var(--color-flame-500) 0 22px,
      transparent 22px 44px
    );
    opacity: 0.85;
    z-index: 2;
  }
  .hero__drip {
    position: absolute;
    top: 0;
    left: 4px;
    width: 2px;
    height: 60px;
    background: linear-gradient(var(--color-amber-400), transparent);
    z-index: 3;
    animation: drip 4.5s ease-in 1.2s infinite;
  }

  .hero__inner {
    position: relative;
    z-index: 5;
    max-width: 820px;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .hero__title {
    color: #fff;
    font-size: clamp(3.6rem, 13vw, 8.5rem);
    line-height: 0.86;
    margin: 0.6rem 0 0;
    text-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
  }
  .hero__title-accent { color: var(--color-flame-500); }
  .hero__lead {
    color: var(--color-steel-300);
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    max-width: 38ch;
    margin: 1.5rem 0 0;
  }
  .hero__lead strong { color: #fff; font-weight: 600; }
  .hero__hl {
    color: var(--color-flame-400);
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.1rem;
  }

  .hero__trust {
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.6rem;
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-steel-300);
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .hero__trust :global(svg) { color: var(--color-flame-500); flex: none; }

  .hero__scroll {
    position: absolute;
    bottom: 4.6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-accent);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .hero__scroll :global(svg) { animation: bob 1.8s ease-in-out infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  .hero__ticker {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--color-navy-950) 75%, transparent);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .hero__ticker-track {
    display: flex;
    gap: 3rem;
    padding: 0.85rem 1.5rem;
    width: max-content;
    animation: ticker 28s linear infinite;
  }
  .hero__ticker-item {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (min-width: 768px) {
    .hero__scroll { display: flex; }
  }
  @media (max-width: 600px) {
    .hero__ticker { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__img { animation: none; transform: none; }
    .hero__ticker-track { animation: none; }
    .hero__drip { display: none; }
  }
</style>
