---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import mechanicImg from "../assets/images/mechanic-engine.jpg";
import oilCloseImg from "../assets/images/oil-pour-closeup.jpg";

const values = [
  {
    icon: "wholesale",
    title: "Hurt i detal",
    text: "Obsługujemy kierowców, warsztaty, firmy i rolnictwo - kupisz jedną butelkę albo zatowarujesz cały serwis.",
  },
  {
    icon: "shield",
    title: "Sprawdzone marki",
    text: "Współpracujemy tylko z renomowanymi producentami olejów i płynów. Żadnych przypadkowych zamienników.",
  },
  {
    icon: "check",
    title: "Fachowe doradztwo",
    text: "Nie wiesz, co wybrać? Doradzimy właściwy olej, płyn czy smar do Twojego auta lub maszyny.",
  },
] as const;
---

<section id="o-nas" class="about" aria-labelledby="about-title">
  <div class="shell about__grid">
    <div class="about__copy">
      <p class="kicker" data-reveal>Kim jesteśmy</p>
      <h2 id="about-title" class="section-title about__title" data-reveal style="--reveal-delay:80ms">
        Twój sklep z olejami<br /><span class="about__title-accent">w sercu Siedlec</span>
      </h2>
      <p class="about__lead" data-reveal style="--reveal-delay:160ms">
        W <strong>PRZEMO-OIL</strong> znajdziesz szeroki wybór olejów, płynów i smarów
        eksploatacyjnych - wszystko, czego potrzeba, aby Twój samochód działał bez zarzutu.
        Masz pytania albo nie wiesz, co wybrać? Chętnie doradzimy i pomożemy dobrać
        odpowiednie produkty.
      </p>

      <div class="about__values" data-reveal style="--reveal-delay:240ms">
        {values.map((v) => (
          <div class="about__value">
            <span class="about__value-icon"><Icon name={v.icon} size={24} /></span>
            <div>
              <h3 class="about__value-title">{v.title}</h3>
              <p class="about__value-text">{v.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="about__media" data-reveal style="--reveal-delay:120ms">
      <div class="about__media-main">
        <Image src={mechanicImg} alt="Mechanik przy pracy nad silnikiem samochodu" widths={[420, 760]} sizes="(max-width:900px) 90vw, 42vw" loading="lazy" />
      </div>
      <div class="about__media-sub">
        <Image src={oilCloseImg} alt="Lanie świeżego oleju silnikowego z butelki" widths={[300, 520]} sizes="(max-width:900px) 50vw, 24vw" loading="lazy" />
      </div>
      <div class="about__badge">
        <span class="about__badge-num">9</span>
        <span class="about__badge-label">marek<br />partnerskich</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    background: var(--color-paper);
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }
  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about__grid { grid-template-columns: 1.05fr 0.95fr; }
  }

  .about__title {
    margin-top: 1rem;
    color: var(--color-navy-900);
  }
  .about__title-accent { color: var(--color-flame-500); }
  .about__lead {
    margin-top: 1.4rem;
    font-size: 1.12rem;
    color: var(--color-ink-soft);
    max-width: 46ch;
  }
  .about__lead strong { color: var(--color-navy-800); }

  .about__values {
    margin-top: 2.2rem;
    display: grid;
    gap: 1.1rem;
  }
  .about__value {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .about__value-icon {
    flex: none;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    color: var(--color-flame-600);
    background: color-mix(in srgb, var(--color-flame-500) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-flame-500) 30%, transparent);
    border-radius: 3px;
  }
  .about__value-title {
    font-size: 1.25rem;
    color: var(--color-navy-900);
    margin-bottom: 0.15rem;
  }
  .about__value-text {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  /* --- media kolaż --- */
  .about__media {
    position: relative;
    aspect-ratio: 4 / 4.2;
    max-width: 520px;
    margin-inline: auto;
    width: 100%;
  }
  .about__media-main,
  .about__media-sub {
    position: absolute;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 30px 60px -30px rgba(6, 13, 32, 0.55);
  }
  .about__media-main {
    inset: 0 0 18% 18%;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 8% 100%);
  }
  .about__media-main :global(img),
  .about__media-sub :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__media-sub {
    width: 46%;
    aspect-ratio: 3 / 3.4;
    left: 0;
    bottom: 0;
    border: 4px solid var(--color-paper);
  }
  .about__badge {
    position: absolute;
    top: -1.2rem;
    right: -0.6rem;
    background: var(--color-navy-800);
    color: #fff;
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 3px;
    box-shadow: 0 20px 40px -18px rgba(13, 27, 62, 0.8);
    border-left: 4px solid var(--color-flame-500);
  }
  .about__badge-num {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--color-flame-400);
  }
  .about__badge-label {
    font-family: var(--font-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.82rem;
    line-height: 1.1;
  }
</style>
