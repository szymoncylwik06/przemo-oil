---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { nav, contact } from "../data/site";
---

<header id="site-header" class="header" data-header>
  <div class="shell header__inner">
    <a href="#top" class="header__brand" aria-label="Przemo-Oil - strona główna">
      <Logo tone="light" />
    </a>

    <nav class="header__nav" aria-label="Główna nawigacja">
      {nav.map((item) => (
        <a href={item.href} class="header__link" data-navlink>{item.label}</a>
      ))}
    </nav>

    <div class="header__actions">
      <a href={contact.phoneHref} class="header__phone" data-call="header">
        <Icon name="phone" size={18} />
        <span>{contact.phoneDisplay}</span>
      </a>
      <button type="button" class="header__burger" data-menu-open aria-label="Otwórz menu" aria-expanded="false">
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>
</header>

<!-- Pełnoekranowe menu mobilne -->
<div class="mobile-menu" data-menu hidden>
  <div class="mobile-menu__head shell">
    <Logo tone="light" />
    <button type="button" class="mobile-menu__close" data-menu-close aria-label="Zamknij menu">
      <Icon name="close" size={28} />
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Nawigacja mobilna">
    {nav.map((item, i) => (
      <a href={item.href} class="mobile-menu__link" data-menu-link style={`--i:${i}`}>
        <span>{item.label}</span>
        <Icon name="arrow-right" size={22} />
      </a>
    ))}
  </nav>
  <div class="mobile-menu__foot shell">
    <a href={contact.phoneHref} class="btn" style="width:100%">
      <Icon name="phone" size={20} /> Zadzwoń: {contact.phoneDisplay}
    </a>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
    background: transparent;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 72px;
  }
  .header[data-scrolled] {
    background: color-mix(in srgb, var(--color-navy-950) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06),
                0 18px 40px -28px rgba(0, 0, 0, 0.9);
  }

  .header__nav {
    display: none;
    gap: 0.35rem;
    margin-left: auto;
  }
  .header__link {
    font-family: var(--font-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.82);
    padding: 0.5rem 0.85rem;
    border-radius: 2px;
    position: relative;
    transition: color 0.2s ease;
  }
  .header__link::after {
    content: "";
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.3rem;
    height: 2px;
    background: var(--color-flame-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .header__link:hover { color: #fff; }
  .header__link:hover::after,
  .header__link[aria-current="true"]::after { transform: scaleX(1); }
  .header__link[aria-current="true"] { color: #fff; }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.5rem;
  }
  .header__phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-accent);
    font-weight: 600;
    color: #fff;
    background: var(--color-flame-500);
    padding: 0.6rem 1.05rem;
    border-radius: 2px;
    letter-spacing: 0.02em;
    transition: transform 0.2s ease, background 0.2s ease;
    box-shadow: 0 10px 22px -12px rgba(211, 95, 18, 0.85);
  }
  .header__phone:hover { transform: translateY(-2px); background: var(--color-flame-400); }

  .header__burger {
    display: inline-flex;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    border-radius: 3px;
    padding: 0.35rem;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .header__burger:hover { background: rgba(255, 255, 255, 0.1); }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 120;
    background:
      radial-gradient(80% 60% at 80% 0%, rgba(232, 122, 32, 0.18), transparent 60%),
      var(--color-navy-950);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu.is-open { opacity: 1; }

  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    flex: none;
  }
  .mobile-menu__close {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    border-radius: 3px;
    padding: 0.35rem;
    cursor: pointer;
  }
  .mobile-menu__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 1.25rem;
    gap: 0.25rem;
  }
  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 2rem;
    letter-spacing: 0.01em;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    opacity: 0;
    transform: translateX(-20px);
  }
  .mobile-menu.is-open .mobile-menu__link {
    animation: slideIn 0.5s var(--ease-out-expo) forwards;
    animation-delay: calc(120ms + var(--i) * 60ms);
  }
  .mobile-menu__link :global(svg) { color: var(--color-flame-500); }
  @keyframes slideIn {
    to { opacity: 1; transform: translateX(0); }
  }
  .mobile-menu__foot {
    flex: none;
    padding-bottom: 2rem;
  }

  @media (min-width: 920px) {
    .header__nav { display: flex; }
    .header__phone { display: inline-flex; }
    .header__burger { display: none; }
  }
</style>
