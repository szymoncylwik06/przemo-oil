---
import Icon from "./Icon.astro";
import { contact, hours } from "../data/site";

const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(contact.mapQuery)}&z=15&output=embed`;
const mapDir = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(contact.mapQuery)}`;
const mapView = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.mapQuery)}`;
---

<section id="kontakt" class="contact noise" aria-labelledby="contact-title">
  <div class="shell">
    <header class="contact__head">
      <p class="kicker kicker--light" data-reveal>Kontakt · Dojazd</p>
      <h2 id="contact-title" class="section-title contact__title" data-reveal style="--reveal-delay:80ms">
        Przyjedź albo zadzwoń
      </h2>
      <p class="contact__intro" data-reveal style="--reveal-delay:160ms">
        Jesteśmy w Siedlcach przy ul. Zambrowskiej 42. Chętnie doradzimy i pomożemy dobrać produkty.
      </p>
    </header>

    <div class="contact__grid">
      <div class="contact__panel" data-reveal>
        <!-- Telefon -->
        <div class="contact__row contact__row--call">
          <span class="contact__ico"><Icon name="phone" size={22} /></span>
          <div class="contact__rowbody">
            <span class="contact__label">Telefon</span>
            <a href={contact.phoneHref} class="contact__phone" data-call="contact">{contact.phoneDisplay}</a>
          </div>
          <button type="button" class="contact__copy" data-copy={contact.phoneDisplay} aria-label="Kopiuj numer telefonu">
            <Icon name="copy" size={18} />
            <span data-copy-label>Kopiuj</span>
          </button>
        </div>

        <!-- E-mail -->
        <a href={contact.emailHref} class="contact__row contact__row--link">
          <span class="contact__ico"><Icon name="mail" size={22} /></span>
          <div class="contact__rowbody">
            <span class="contact__label">E-mail</span>
            <span class="contact__value">{contact.email}</span>
          </div>
          <Icon name="arrow-right" size={20} class="contact__chev" />
        </a>

        <!-- Adres -->
        <a href={mapView} target="_blank" rel="noopener noreferrer" class="contact__row contact__row--link">
          <span class="contact__ico"><Icon name="pin" size={22} /></span>
          <div class="contact__rowbody">
            <span class="contact__label">Adres</span>
            <span class="contact__value">{contact.street}, {contact.postal} {contact.city}</span>
          </div>
          <Icon name="arrow-right" size={20} class="contact__chev" />
        </a>

        <!-- Godziny (placeholder) -->
        <div class="contact__row contact__row--hours">
          <span class="contact__ico"><Icon name="clock" size={22} /></span>
          <div class="contact__rowbody">
            <span class="contact__label">Godziny otwarcia</span>
            <ul class="contact__hours">
              {hours.rows.map((h) => (
                <li><span>{h.day}</span><span>{h.time}</span></li>
              ))}
            </ul>
            {hours.unconfirmed && (
              <span class="contact__hint">* przykładowe godziny - do potwierdzenia</span>
            )}
          </div>
        </div>

        <div class="contact__actions">
          <a href={contact.phoneHref} class="btn" data-call="contact-cta">
            <Icon name="phone" size={20} /> Zadzwoń teraz
          </a>
          <a href={mapDir} target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--ghost-dark">
            <Icon name="route" size={20} /> Wyznacz trasę
          </a>
        </div>

        <a href={contact.facebook} target="_blank" rel="noopener noreferrer" class="contact__fb">
          <Icon name="facebook" size={18} /> Śledź nas na Facebooku
        </a>
      </div>

      <div class="contact__map" data-reveal style="--reveal-delay:120ms">
        <iframe
          title="Mapa dojazdu do Przemo-Oil, ul. Zambrowska 42, Siedlce"
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--color-navy-900);
    color: #fff;
    padding: clamp(4.5rem, 9vw, 7rem) 0;
  }
  .contact__head { max-width: 640px; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .contact__title { color: #fff; margin-top: 0.8rem; }
  .contact__intro { color: var(--color-steel-300); margin-top: 1.1rem; font-size: 1.05rem; }

  .contact__grid {
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
  }
  @media (min-width: 900px) {
    .contact__grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }

  .contact__panel {
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    padding: clamp(1.4rem, 3vw, 2.1rem);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact__row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .contact__ico {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--color-flame-400);
    background: rgba(245, 147, 49, 0.1);
    border: 1px solid rgba(245, 147, 49, 0.28);
    border-radius: 3px;
  }
  .contact__rowbody { flex: 1; min-width: 0; }
  .contact__label {
    display: block;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--color-steel-400);
    margin-bottom: 0.2rem;
  }
  .contact__value { color: #fff; font-size: 1.05rem; word-break: break-word; }
  .contact__phone {
    font-family: var(--font-display);
    font-size: 1.85rem;
    color: #fff;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
  .contact__phone:hover { color: var(--color-flame-400); }

  .contact__row--link { transition: background 0.2s ease; border-radius: 3px; }
  .contact__row--link:hover { background: rgba(255, 255, 255, 0.04); }
  .contact__chev { color: var(--color-steel-400); align-self: center; transition: transform 0.25s ease, color 0.25s ease; }
  .contact__row--link:hover .contact__chev { color: var(--color-flame-400); transform: translateX(4px); }

  .contact__copy {
    flex: none;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 0.82rem;
    padding: 0.45rem 0.7rem;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .contact__copy:hover { background: var(--color-flame-500); border-color: var(--color-flame-500); }
  .contact__copy.is-copied { background: #1f9d55; border-color: #1f9d55; }

  .contact__hours {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .contact__hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-steel-300);
    font-size: 0.98rem;
  }
  .contact__hours li span:last-child { color: #fff; font-family: var(--font-accent); font-weight: 600; }
  .contact__hint {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--color-steel-400);
    font-style: italic;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.3rem;
  }
  .contact__actions .btn { flex: 1 1 auto; }
  .btn--ghost-dark { color: #fff; }

  .contact__fb {
    margin-top: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-steel-300);
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }
  .contact__fb:hover { color: #fff; }
  .contact__fb :global(svg) { color: #4d8bf0; }

  .contact__map {
    position: relative;
    min-height: 320px;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.8);
  }
  .contact__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.2) contrast(1.05);
  }
</style>
