---
/**
 * Dedykowane ikony kategorii asortymentu (motoryzacyjne, linearne).
 * stroke = currentColor.
 */
interface Props {
  name: "engine" | "gearbox" | "hydraulic" | "coolant" | "washer" | "grease";
  class?: string;
  size?: number;
}
const { name, class: className = "", size = 40 } = Astro.props;
const s = size;
const common = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

{name === "engine" && (
  <svg class={className} width={s} height={s} viewBox="0 0 48 48" {...common} aria-hidden="true">
    <path d="M8 22h4v-4h7l3-3h6v3h4l3 3h4v8h-3v5h-5l-3 3H17l-3-3h-2v-4H8v-8Z" />
    <path d="M26 15v-3h6" />
    <path d="M40 24h4M12 28H6" />
  </svg>
)}
{name === "gearbox" && (
  <svg class={className} width={s} height={s} viewBox="0 0 48 48" {...common} aria-hidden="true">
    <circle cx="24" cy="24" r="7" />
    <circle cx="24" cy="24" r="2.4" />
    <path d="M24 6v5M24 37v5M6 24h5M37 24h5M11.5 11.5l3.5 3.5M33 33l3.5 3.5M36.5 11.5 33 15M15 33l-3.5 3.5" />
  </svg>
)}
{name === "hydraulic" && (
  <svg class={className} width={s} height={s} viewBox="0 0 48 48" {...common} aria-hidden="true">
    <rect x="6" y="20" width="16" height="8" rx="1.5" />
    <path d="M22 24h7M29 18v12M29 24h6a4 4 0 0 0 4-4v-2" />
    <path d="M39 12v6M36 15h6" />
    <path d="M6 24H4" />
  </svg>
)}
{name === "coolant" && (
  <svg class={className} width={s} height={s} viewBox="0 0 48 48" {...common} aria-hidden="true">
    <path d="M24 7s7 8.5 7 14a7 7 0 0 1-14 0c0-5.5 7-14 7-14Z" />
    <path d="M24 33v8M19 38l5 3 5-3" />
    <path d="M21 21c0 2 1.5 3 3 3" />
  </svg>
)}
{name === "washer" && (
  <svg class={className} width={s} height={s} viewBox="0 0 48 48" {...common} aria-hidden="true">
    <path d="M16 18h12l2 18a3 3 0 0 1-3 3H17a3 3 0 0 1-3-3l2-18Z" />
    <path d="M19 18v-3a3 3 0 0 1 3-3h2.5" />
    <path d="M24.5 12V8M28 9.5h4M30 6v6" />
    <path d="M20 26h8" />
  </svg>
)}
{name === "grease" && (
  <svg class={className} width={s} height={s} viewBox="0 0 48 48" {...common} aria-hidden="true">
    <path d="M14 20h10v16a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3V20Z" />
    <path d="M24 24h9l5-4v8l-5-2h-9" />
    <path d="M16 20v-4h6v4M18 12h2" />
  </svg>
)}
