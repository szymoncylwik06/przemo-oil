---
import ProductIcon from "./ProductIcon.astro";
import Icon from "./Icon.astro";
import { products, contact } from "../data/site";
---

<section id="asortyment" class="products noise oil-glow" aria-labelledby="products-title">
  <div class="shell">
    <header class="products__head">
      <div>
        <p class="kicker kicker--light" data-reveal>Asortyment</p>
        <h2 id="products-title" class="section-title products__title" data-reveal style="--reveal-delay:80ms">
          Wszystko, czego potrzebuje<br />Twój samochód i maszyny
        </h2>
      </div>
      <p class="products__intro" data-reveal style="--reveal-delay:160ms">
        Sześć kategorii produktów eksploatacyjnych - od olejów silnikowych po smary.
        Nie masz pewności, co wybrać? <a href={contact.phoneHref} class="link-underline" data-call="products">Zadzwoń, doradzimy.</a>
      </p>
    </header>

    <ul class="products__grid">
      {products.map((p, i) => (
        <li class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <span class="card__num">{String(i + 1).padStart(2, "0")}</span>
          <span class="card__icon"><ProductIcon name={p.icon} size={44} /></span>
          <h3 class="card__title">{p.name}</h3>
          <p class="card__text">{p.desc}</p>
          <span class="card__line" aria-hidden="true"></span>
        </li>
      ))}
    </ul>

    <div class="products__cta" data-reveal>
      <span>Szukasz konkretnego produktu lub większej ilości?</span>
      <a href={contact.phoneHref} class="btn" data-call="products-cta">
        <Icon name="phone" size={20} /> {contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .products {
    position: relative;
    background: var(--color-navy-900);
    color: #fff;
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }

  .products__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 880px) {
    .products__head {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }
  .products__title { color: #fff; margin-top: 1rem; }
  .products__intro {
    color: var(--color-steel-300);
    font-size: 1.05rem;
    max-width: 40ch;
  }
  .products__intro a { color: var(--color-flame-400); font-weight: 600; }

  .products__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) { .products__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .products__grid { grid-template-columns: repeat(3, 1fr); } }

  .card {
    position: relative;
    padding: 1.8rem 1.6rem 2rem;
    background: linear-gradient(165deg, rgba(34, 53, 106, 0.4), rgba(10, 21, 48, 0.4));
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.35s var(--ease-out-expo),
                border-color 0.35s ease, background 0.35s ease;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 100% 0%, rgba(232, 122, 32, 0.16), transparent 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-flame-500) 55%, transparent);
  }
  .card:hover::before { opacity: 1; }

  .card__num {
    position: absolute;
    top: 1.1rem;
    right: 1.3rem;
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: rgba(255, 255, 255, 0.1);
    transition: color 0.35s ease;
  }
  .card:hover .card__num { color: color-mix(in srgb, var(--color-flame-500) 35%, transparent); }

  .card__icon {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    color: var(--color-flame-400);
    border: 1px solid rgba(245, 147, 49, 0.3);
    background: rgba(245, 147, 49, 0.08);
    border-radius: 3px;
    margin-bottom: 1.3rem;
    transition: transform 0.35s var(--ease-out-expo);
  }
  .card:hover .card__icon { transform: scale(1.06) rotate(-2deg); }

  .card__title {
    position: relative;
    z-index: 1;
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .card__text {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--color-steel-300);
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .card__line {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: var(--color-flame-500);
    transition: width 0.4s var(--ease-out-expo);
  }
  .card:hover .card__line { width: 100%; }

  .products__cta {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.6rem 1.8rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 4px solid var(--color-flame-500);
    border-radius: 4px;
  }
  .products__cta span {
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 1.15rem;
    color: #fff;
  }
</style>
